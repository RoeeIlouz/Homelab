# ==============================================================================
# MEDIA STACK CONFIGURATION (.env)
# ==============================================================================

# User and Group ID
PUID=1000
PGID=1000
TZ=Asia/Jerusalem

# Storage Roots
STORAGE_ROOT=/srv/dev-disk-by-uuid-ef4cba07-46ee-4337-a6a0-c35e8399f14b/Docker
MEDIA_DATA_ROOT=/data

# VPN Gateway (Gluetun) Settings
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=YOUR_WIREGUARD_PRIVATE_KEY_HERE
WIREGUARD_ADDRESSES=10.x.x.x/32
VPN_SERVER_COUNTRIES=Switzerland
VPN_FORWARDED_PORT=6881
HEALTH_VPN_DURATION_INITIAL=30s

# Downloader Credentials
NZBGET_USER=admin
NZBGET_PASS=change_this_password
